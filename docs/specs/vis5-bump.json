{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Cape York Peninsula national parks reached 5th place in 2013, from 8th place in 2008.",
    "subtitle": [
      "Queensland protected area categories ranked by number of protected areas, 2008 to 2024.",
      "Nature refuge has consistently the most number of protected areas throughout 2008 to 2024, with national parks* consistently 2nd.",
      "* excludes Aboriginal land, Cape York, scientific and recovery national parks.",
      "Gaps mark years when a category did not exist.",
      " ",
      "Source: Queensland Government, indicator 1.1.0.3.1."
    ],
    "anchor": "start"
  },
  "data": {
    "url": "data/qld_rank_series.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "number": "number",
        "is_first": "number",
        "is_last": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "groupby": [
        "year"
      ],
      "sort": [
        {
          "field": "number",
          "order": "descending"
        },
        {
          "field": "short_label",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "indexof([\"National park\",\"NP (scientific)\",\"NP (recovery)\",\"NP (Aboriginal land)\",\"NP (Cape York Peninsula)\"], datum.short_label) >= 0 ? 'National parks' : 'Other protected area types'",
      "as": "group"
    },
    {
      "window": [
        {
          "op": "min",
          "field": "year",
          "as": "segment_start_year"
        }
      ],
      "groupby": [
        "segment"
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "window": [
        {
          "op": "max",
          "field": "year",
          "as": "segment_end_year"
        }
      ],
      "groupby": [
        "segment"
      ],
      "frame": [
        null,
        null
      ]
    }
  ],
  "width": 620,
  "height": 330,
  "padding": {
    "left": 5,
    "top": 5,
    "right": 12,
    "bottom": 14
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "scale": {
        "domain": [
          2008,
          2009,
          2010,
          2011,
          2012,
          2013,
          2014,
          2015,
          2016,
          2017,
          2018,
          2019,
          2020,
          2021,
          2022,
          2023,
          2024
        ]
      },
      "axis": {
        "title": "Year",
        "titleFontSize": 12,
        "titleColor": "#6b7780",
        "labelAngle": 0,
        "labelFontSize": 11,
        "labelColor": "#6b7780",
        "grid": false,
        "domain": false,
        "ticks": false,
        "labelPadding": 6
      }
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "year": 2014,
            "label": "Park categories reclassified",
            "at_rank": 8.6
          },
          {
            "year": 2016,
            "label": "Scientific parks reinstated",
            "at_rank": 9.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#9aa5ac",
        "strokeWidth": 1,
        "strokeDash": [
          4,
          3
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2014,
            "label": "Park categories reclassified",
            "at_rank": 8.6
          },
          {
            "year": 2016,
            "label": "Scientific parks reinstated",
            "at_rank": 9.5
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "baseline": "middle",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#6b7780"
      },
      "encoding": {
        "y": {
          "field": "at_rank",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeCap": "round"
      },
      "encoding": {
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              9.9
            ],
            "reverse": true,
            "nice": false
          },
          "axis": {
            "title": "Rank by number of protected areas",
            "titleFontSize": 12,
            "titleColor": "#6b7780",
            "values": [
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8,
              9
            ],
            "labelFontSize": 11,
            "labelColor": "#6b7780",
            "grid": true,
            "gridColor": "#eceff1",
            "domain": false,
            "ticks": false,
            "minExtent": 46,
            "maxExtent": 46
          }
        },
        "detail": {
          "field": "segment"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "National parks",
              "Other protected area types"
            ],
            "range": [
              "#0b4a4f",
              "#b0bec5"
            ]
          },
          "legend": {
            "title": "Protected area type",
            "orient": "none",
            "direction": "horizontal",
            "titleOrient": "top",
            "titleAnchor": "start",
            "legendX": -46,
            "legendY": 382,
            "symbolType": "stroke",
            "symbolStrokeWidth": 4
          }
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.group === 'National parks'",
            "value": 3
          },
          "value": 1.8
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 55,
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },
      "encoding": {
        "y": {
          "field": "rank",
          "type": "quantitative"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "National parks",
              "Other protected area types"
            ],
            "range": [
              "#0b4a4f",
              "#b0bec5"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "category",
            "title": "Category"
          },
          {
            "field": "year",
            "type": "quantitative",
            "format": "d",
            "title": "Year"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank"
          },
          {
            "field": "number",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Protected areas"
          },
          {
            "field": "tenure",
            "title": "Tenure"
          },
          {
            "field": "status",
            "title": "Over the period"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_last === 1 && datum.year === 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "baseline": "middle",
        "fontSize": 11.5,
        "fontWeight": 600
      },
      "encoding": {
        "y": {
          "field": "rank",
          "type": "quantitative"
        },
        "text": {
          "field": "short_label"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "National parks",
              "Other protected area types"
            ],
            "range": [
              "#0b4a4f",
              "#b0bec5"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_last === 1 && datum.year !== 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "dy": -13,
        "baseline": "middle",
        "fontSize": 11.5,
        "fontWeight": 600
      },
      "encoding": {
        "y": {
          "field": "rank",
          "type": "quantitative"
        },
        "text": {
          "field": "short_label"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "National parks",
              "Other protected area types"
            ],
            "range": [
              "#0b4a4f",
              "#b0bec5"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === datum.segment_end_year && datum.is_last !== 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": 4,
        "dy": 13,
        "baseline": "middle",
        "fontSize": 11.5,
        "fontWeight": 600
      },
      "encoding": {
        "y": {
          "field": "rank",
          "type": "quantitative"
        },
        "text": {
          "field": "short_label"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "National parks",
              "Other protected area types"
            ],
            "range": [
              "#0b4a4f",
              "#b0bec5"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === datum.segment_start_year && datum.is_first !== 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "dy": -13,
        "baseline": "middle",
        "fontSize": 11.5,
        "fontWeight": 600
      },
      "encoding": {
        "y": {
          "field": "rank",
          "type": "quantitative"
        },
        "text": {
          "field": "short_label"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "National parks",
              "Other protected area types"
            ],
            "range": [
              "#0b4a4f",
              "#b0bec5"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "font": "system-ui, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 18,
      "fontWeight": 600,
      "subtitleFontSize": 13,
      "subtitleColor": "#555",
      "subtitlePadding": 4
    },
    "legend": {
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelFontSize": 12,
      "titlePadding": 6,
      "labelOffset": 5,
      "titleLimit": 420,
      "labelLimit": 260
    }
  }
}
